{
  "name": "@qed-proof/sdk",
  "version": "0.4.1",
  "description": "TypeScript SDK for QED Proof: submit claims, poll verdicts, and verify PoAW receipts offline. Runs on Node, Deno and browsers.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run copy:schema && npm run build:validator && tsup",
    "copy:schema": "node scripts/copy-schema.mjs",
    "gen:types": "node scripts/gen-types.mjs",
    "test": "vitest run",
    "lint": "true",
    "build:validator": "node scripts/build-validator.mjs",
    "check:validator": "node scripts/build-validator.mjs --check"
  },
  "dependencies": {
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "canonicalize": "^2.0.0"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.2",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11",
    "ajv": "^8.17.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://docs.qedproof.site",
  "keywords": [
    "qed-proof",
    "poaw",
    "receipts",
    "verification"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nuraveda/qed-proof-js.git",
    "directory": "packages/sdk"
  }
}
